# --- LLM ---
GEMINI_API_KEY=

# --- Featherless.ai (open-source LLM for prose synthesis) ---
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Investigation tools ---
TAVILY_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Ingestion & Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# --- Infra ---
CHROMA_PERSIST_DIR=./data/chroma
DATABASE_URL=sqlite+aiosqlite:///./data/herd.db
HF_HOME=./data/hf_cache
SENTENCE_TRANSFORMERS_HOME=./data/hf_cache

# --- Active institution ---
# Must match a filename stem in config/institutions/.
# Nothing institution-specific belongs in this file — see ADR-0026.
HERD_INSTITUTION=vnrvjiet

# --- Identity ---
# Salt for pseudonymous reporter hashing. Rotate every 30 days (ADR-0004).
REPORTER_HASH_SALT=

# --- Runtime ---
DEMO_MODE=live
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
